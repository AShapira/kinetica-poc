# Mutable vendor installer; provenance and checksum are in KINETICA_ARTIFACTS.md.
/kinetica
/kinetica.upstream
/patches/

# Prevent accidental check-in of local runtime data if a developer overrides
# the deployment's external persistence directory.
/kinetica-persist/

# Credentials and local configuration overrides.
.env
.env.*
!.env.example
*.key
*.pem
*password*
*secret*

# Sedona benchmark runtime state and full generated data. Curated manifests,
# samples, summaries, and plots under evidence/ remain tracked.
/.env
/.venv/
/.pytest_cache/
/.ruff_cache/
/runtime/
/data/
/results/raw/
/notebooks/.ipynb_checkpoints/
__pycache__/
*.py[cod]
