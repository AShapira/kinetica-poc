# Required host paths. Keep machine-specific values in .env (ignored by Git).
OVERTURE_RELEASE_DIR=/path/to/overture/release/2026-07-22.0
BENCHMARK_DATA_DIR=/path/to/sedona-benchmark

# Kinetica credentials must be stored in mode-0600 files outside Git.
KINETICA_USER=admin
KINETICA_PASSWORD_FILE=/path/to/kinetica-admin-password

# Optional loopback ports for interactive learning services.
SEDONADB_JUPYTER_PORT=8889
SEDONASPARK_JUPYTER_PORT=8890
