{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sedona-benchmark/dataset-manifest.schema.json",
  "title": "Sedona benchmark dataset manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "dataset_id", "stage", "created_at", "generator", "source_release", "crs", "geometry_type", "row_count", "files", "bounds", "validation"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["external", "intermediate", "canonical", "final"]},
    "created_at": {"type": "string", "format": "date-time"},
    "generator": {"type": "object", "required": ["command", "config_sha256"]},
    "source_release": {"type": "string"},
    "parents": {"type": "array", "items": {"type": "string"}},
    "crs": {"type": "string"},
    "geometry_type": {"type": "string"},
    "row_count": {"type": "integer", "minimum": 0},
    "files": {"type": "array", "items": {"type": "object", "required": ["path", "bytes", "sha256"]}},
    "bounds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "statistics": {"type": "object"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "validation": {"type": "object", "required": ["passed"]},
    "license": {"type": "string"}
  }
}
